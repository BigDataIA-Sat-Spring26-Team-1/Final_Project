# CurateAI Frontend — local environment template.
#
# Copy this file to `.env.local` (which stays out of git by Next.js convention)
# and point NEXT_PUBLIC_API_URL at whichever backend you're targeting.
#
# In production the same variable is baked in at build time via the Cloud Run
# build step — never at runtime, since `NEXT_PUBLIC_*` values are inlined into
# the client bundle during `next build`.

# Local FastAPI (uv run uvicorn ... --port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Docker (docker run ... -p 8080:8080 curateai-backend:test)
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Staging / prod examples — replace with the actual Cloud Run URL
# NEXT_PUBLIC_API_URL=https://curateai-backend-xxxxx-uc.a.run.app
