# Keep the build context small — everything listed here is excluded from the
# `COPY . .` that Docker performs before running any Dockerfile instructions.
# Smaller context = faster builds and smaller final images.

# --- VCS / editors ---
.git
.gitignore
.vscode
.idea
.DS_Store

# --- Local Python environments & caches ---
.venv
venv
env
__pycache__
*.pyc
*.pyo
*.egg-info
.python-version

# --- Tooling caches ---
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.tox

# --- Secrets / env files (must come from Cloud Run secrets, never the image) ---
.env
.env.*
!.env.example

# --- Dev/admin tooling not needed at runtime ---
tests
testing
scripts
logs

# --- Docs / meta (not needed inside the running container) ---
*.md
Dockerfile
.dockerignore
