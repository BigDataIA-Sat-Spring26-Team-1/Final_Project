# ------------------------------------------------------------------------------
# CurateAI Backend — environment variable template
#
# Copy this file to `.env` for local runs. On Cloud Run, wire every REQUIRED
# entry below through Google Secret Manager and inject the rest as plain env
# vars at deploy time. The backend will never read a .env file in production.
#
# Fields are listed in the same order as `app/core/config.py` so diffs are easy.
# ------------------------------------------------------------------------------

# ---- Application identity ----------------------------------------------------
APP_NAME=Curate AI
APP_VERSION=1.0.0
# dev | uat | prod — dev gets coloured console logs; uat/prod emit JSON.
APP_ENV=dev
# REQUIRED. Used for any signed cookies / session state. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-before-prod

# ---- HTTP server -------------------------------------------------------------
# Cloud Run injects PORT automatically; this default is for local dev only.
PORT=8080
# Comma-separated list of allowed browser origins for CORS. Add the deployed
# frontend URL(s) here in uat/prod. No trailing slashes.
CORS_ORIGINS=http://localhost:3000

# ---- Snowflake (REQUIRED) ----------------------------------------------------
SNOWFLAKE_ACCOUNT=xxxxx-xx00000
SNOWFLAKE_USER=curateai_app
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=CURATEAI
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=APP_ROLE

# ---- External APIs (REQUIRED) ------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# ---- Qdrant Vector DB --------------------------------------------------------
# Local docker-compose default. Replace with the Qdrant Cloud URL in prod.
QDRANT_URL=http://localhost:6333
# Leave blank locally; REQUIRED when Qdrant Cloud enforces auth.
QDRANT_API_KEY=

# ---- Intelligence engine (tweakable; sane defaults shipped in config.py) ----
DEFAULT_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION_SIZE=1536
DEDUPLICATION_THRESHOLD=0.75

# ---- Trend analysis benchmarks -----------------------------------------------
TREND_BREAKING_THRESHOLD=3
TREND_TRENDING_THRESHOLD=2
TREND_VIRAL_SOCIAL_BENCHMARK=500
TREND_COMMUNITY_PICK_SOCIAL_BENCHMARK=150
TREND_CLUSTER_MIN_SIZE=3

# ---- Gmail SMTP (newsletter delivery) ----------------------------------------
# Leave SMTP_USERNAME / SMTP_PASSWORD empty to keep the send endpoint
# disabled (returns {"status": "MAILER_DISABLED"}). Use an App Password
# generated at https://myaccount.google.com/apppasswords — never a real
# Google password. In GCP, SMTP_PASSWORD is pulled from Secret Manager.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CurateAI Newsletter
# Safety rail — when set, every send is rerouted to this address regardless
# of the recipient's stored email. Leave EMPTY in production.
SMTP_TEST_RECIPIENT=
